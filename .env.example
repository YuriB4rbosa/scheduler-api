# Copie para .env e ajuste. Nunca commite o .env.
FLASK_APP=wsgi:app
APP_ENV=development            # development | testing | production

# Gere cada uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# O container do Postgres publica a porta 5433 (a 5432 costuma estar ocupada por um Postgres local).
DATABASE_URL=postgresql+psycopg://scheduler:scheduler@localhost:5433/scheduler
TEST_DATABASE_URL=postgresql+psycopg://scheduler:scheduler@localhost:5433/scheduler_test

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Limite de tentativas em /auth/login e /auth/register (por IP).
AUTH_RATE_LIMIT=10 per minute
# Em memória por padrão (por processo). Com vários workers use Redis: redis://host:6379/0
RATELIMIT_STORAGE_URI=memory://

# Senha do usuário de demonstração criado por `flask seed`.
# Em development, se vazia, usa "demo12345". Fora disso a variável é obrigatória.
# O seed é bloqueado quando APP_ENV=production.
SEED_DEMO_PASSWORD=
