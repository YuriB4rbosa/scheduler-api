    {
      "name": "Appointments",
      "description": "",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/appointments?status=scheduled&sort=start_at&order=asc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "appointments"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "scheduled",
                  "disabled": false
                },
                {
                  "key": "customer_id",
                  "value": "{{customer_id}}",
                  "disabled": true
                },
                {
                  "key": "service_id",
                  "value": "{{service_id}}",
                  "disabled": true
                },
                {
                  "key": "date_from",
                  "value": "2030-01-01T00:00:00Z",
                  "disabled": true
                },
                {
                  "key": "date_to",
                  "value": "2031-01-01T00:00:00Z",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "start_at",
                  "disabled": false
                },
                {
                  "key": "order",
                  "value": "asc",
                  "disabled": false
                }
              ]
            },
            "description": "Datas exigem fuso. date_from é inclusivo e date_to é exclusivo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/appointments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "appointments"
              ]
            },
            "description": "Rode duas vezes seguidas: a segunda retorna 409 APPOINTMENT_CONFLICT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"service_id\": \"{{service_id}}\",\n  \"start_at\": \"{{start_at}}\",\n  \"notes\": \"Criado pelo Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Início = daqui a 7 dias, em hora cheia (UTC), com fuso explícito no ISO.",
                  "const d = new Date(Date.now() + 7 * 24 * 3600 * 1000);",
                  "d.setUTCMinutes(0, 0, 0);",
                  "pm.collectionVariables.set('start_at', d.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 criado ou 409 conflito', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('appointment_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalhar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/appointments/{{appointment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "appointments",
                "{{appointment_id}}"
