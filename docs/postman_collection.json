                ]
              }
            }
          ]
        },
        {
          "name": "Reagendar (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/appointments/{{appointment_id}}",
